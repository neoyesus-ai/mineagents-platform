{
  "name": "mineagents-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Base modular para una plataforma de agentes colaborativos de Minecraft Java Edition.",
  "license": "MIT",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "workspaces": [
    "sdk",
    "coordinator",
    "agents/*",
    "planner",
    "memory",
    "dashboard",
    "blueprints"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run build --workspaces --if-present && node --test tests/*.test.mjs",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "@types/node": "^22.18.0"
  }
}
